{
  "info": {
    "name": "PBI-10 - Lihat Detail Lapangan",
    "_postman_id": "9a2d4f35-5fb0-49a2-9adf-3b2720058f2c",
    "description": "Collection untuk verifikasi endpoint PBI-10: daftar lapangan, detail lapangan, dan availability slot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET Daftar Lapangan",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/courts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "courts"
          ]
        },
        "description": "Ambil daftar lapangan aktif untuk landing page dan entry point detail."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Response status field = 200', function () {",
              "  pm.expect(json.status).to.eql(200);",
              "});",
              "",
              "pm.test('Data lapangan berupa array dan tidak kosong', function () {",
              "  pm.expect(json.data).to.be.an('array');",
              "  pm.expect(json.data.length).to.be.above(0);",
              "});",
              "",
              "if (Array.isArray(json.data) && json.data.length > 0) {",
              "  pm.collectionVariables.set('courtId', json.data[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET Detail Lapangan by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/courts/{{courtId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "courts",
            "{{courtId}}"
          ]
        },
        "description": "Ambil detail lapangan berdasarkan ID untuk halaman detail court."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Response status field = 200', function () {",
              "  pm.expect(json.status).to.eql(200);",
              "});",
              "",
              "pm.test('Data detail lapangan berisi field wajib', function () {",
              "  pm.expect(json.data).to.be.an('object');",
              "  pm.expect(json.data.id).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.name).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.kode).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.status).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.tarifPerJam).to.be.a('number');",
              "  pm.expect(json.data.fasilitas).to.be.an('array');",
              "});",
              "",
              "pm.test('ID detail sesuai dengan courtId request', function () {",
              "  pm.expect(json.data.id).to.eql(pm.collectionVariables.get('courtId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. GET Availability by Date",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bookings/availability?date={{availabilityDate}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings",
            "availability"
          ],
          "query": [
            {
              "key": "date",
              "value": "{{availabilityDate}}"
            }
          ]
        },
        "description": "Ambil slot ketersediaan semua lapangan untuk tanggal tertentu."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Response status field = 200', function () {",
              "  pm.expect(json.status).to.eql(200);",
              "});",
              "",
              "pm.test('Data availability berupa array dan memiliki slot', function () {",
              "  pm.expect(json.data).to.be.an('array');",
              "  pm.expect(json.data.length).to.be.above(0);",
              "  pm.expect(json.data[0].slots).to.be.an('array');",
              "  pm.expect(json.data[0].slots.length).to.be.above(0);",
              "});",
              "",
              "pm.test('Setiap slot punya startHour, endHour, available', function () {",
              "  const slots = json.data[0].slots;",
              "  const first = slots[0];",
              "  pm.expect(first.startHour).to.be.a('number');",
              "  pm.expect(first.endHour).to.be.a('number');",
              "  pm.expect(first.available).to.be.a('boolean');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. GET Detail Lapangan Not Found",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/courts/{{invalidCourtId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "courts",
            "{{invalidCourtId}}"
          ]
        },
        "description": "Validasi error handling ketika ID lapangan tidak ditemukan."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status 404', function () {",
              "  pm.response.to.have.status(404);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Response status field = 404', function () {",
              "  pm.expect(json.status).to.eql(404);",
              "});",
              "",
              "pm.test('Message mengandung Lapangan tidak ditemukan', function () {",
              "  pm.expect(json.message).to.include('Lapangan tidak ditemukan');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "courtId",
      "value": ""
    },
    {
      "key": "availabilityDate",
      "value": "2026-04-18"
    },
    {
      "key": "invalidCourtId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ]
}
